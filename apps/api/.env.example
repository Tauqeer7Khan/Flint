# PostgreSQL database connection string (Neon direct or pooler URL in prod, local container in dev)
DATABASE_URL="postgresql://flint:flint@localhost:5432/flint?schema=public"

# Secret key used for signing session JWT cookies and socket handshake tokens
JWT_SECRET="flint-super-secret-jwt-key-2026"

# Allowed web origin(s) for CORS, origin check, and cookie security (comma-separated for multiple)
WEB_ORIGIN="http://localhost:3000"

# Port number for the Express HTTP/WebSocket server to listen on (Railway injects PORT automatically)
PORT=4000

# Enables compressed SLA timers (2m urgent, 5m high) and 1-click /auth/demo role logins
DEMO_MODE=true

# Node environment mode ('development' or 'production'; enables trust proxy in production)
NODE_ENV=production

# Safety guard override flag required to execute db:reset against non-localhost database hosts
ALLOW_REMOTE_RESET=0
