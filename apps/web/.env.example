# Server-side API URL for Next.js rewrites and server component fetches (evaluated at build time for rewrites)
API_URL="http://localhost:4000"

# Public client-side URL for direct Socket.io WebSocket connections (bypasses Next.js proxy)
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# Node environment mode ('development' or 'production')
NODE_ENV=production
